{
    "$defs": {
        "Attribute": {
            "properties": {
                "label": {
                    "type": "string"
                },
                "items": {
                    "items": {
                        "oneOf": [
                            {
                                "$ref": "#/$defs/DateTimeAttributeItemsElement"
                            },
                            {
                                "$ref": "#/$defs/BoolAttributeItemsElement"
                            },
                            {
                                "$ref": "#/$defs/TextAttributeItemsElement"
                            },
                            {
                                "$ref": "#/$defs/NumericAttributeItemsElement"
                            },
                            {
                                "$ref": "#/$defs/ReferenceAttributeItemsElement"
                            },
                            {
                                "$ref": "#/$defs/ResourceAttributeItemsElement"
                            },
                            {
                                "$ref": "#/$defs/ObjectAttributeItemsElement"
                            }
                        ]
                    },
                    "type": "array"
                }
            },
            "required": [
                "label",
                "items"
            ],
            "type": "object"
        },
        "AttributeGroup": {
            "properties": {
                "group_key": {
                    "type": "string"
                },
                "group_label": {
                    "type": "string"
                },
                "attributes": {
                    "type": "object",
                    "additionalProperties": {
                      "$ref": "#/$defs/Attribute"
                    }
                  }
            },
            "required": [
                "group_key",
                "group_label",
                "attributes"
            ],
            "type": "object"
        },
        "AttributesOfItem": {
            "properties": {
                "id": {
                    "type": "string"
                },
                "attribute_groups": {
                    "items": {
                        "$ref": "#/$defs/AttributeGroup"
                    },
                    "type": "array"
                }
            },
            "required": [
                "id",
                "attribute_groups"
            ],
            "type": "object"
        },
        "BoolAttributeItemsElement": {
            "properties": {
                "value": {
                    "type": "boolean"
                },
                "type": { "const": "bool" }
            },
            "required": [
                "value"
            ],
            "type": "object"
        },
        "DateTimeAttributeItemsElement": {
            "properties": {
                "value": {
                    "anyOf": [
                        {
                            "format": "date",
                            "type": "string"
                        },
                        {
                            "format": "date-time",
                            "type": "string"
                        }
                    ]
                },
                "type": { "const": "datetime" }
            },
            "required": [
                "value"
            ],
            "type": "object"
        },
        "NumericAttributeItemsElement": {
            "properties": {
                "value": {
                    "type": "string"
                },
                "type": { "const": "numeric" }
            },
            "required": [
                "value"
            ],
            "type": "object"
        },
        "ObjectAttributeItemsElement": {
            "properties": {
                "value": {
                    "type": "object"
                },
                "type": { "const": "object" }
            },
            "required": [
                "value"
            ],
            "type": "object"
        },
        "ReferenceAttributeItemsElement": {
            "properties": {
                "value": {
                    "type": "string"
                },
                "type": { "const": "reference" }
            },
            "required": [
                "value"
            ],
            "type": "object"
        },
        "ResourceAttributeItemsElement": {
            "properties": {
                "value": {
                    "type": "string"
                },
                "type": { "const": "resource" }
            },
            "required": [
                "value"
            ],
            "type": "object"
        },
        "TextAttributeItemsElement": {
            "properties": {
                "value": {
                    "type": "string"
                },
                "type": { "const": "text" }
            },
            "required": [
                "value"
            ],
            "type": "object"
        }
    },
    "properties": {
        "schema_version": {
            "type": "string"
        },
        "language": {
            "type": "string"
        },
        "data": {
            "items": {
                "$ref": "#/$defs/AttributesOfItem"
            },
            "type": "array"
        },
        "@context": {
            "type": "string",
            "const": "https://vocab.labfreed.org/attributes/v1.jsonld"
        }
    },
    "required": [
        "schema_version",
        "language",
        "data",
        "@context"
    ],
    "type": "object"
}